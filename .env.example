# Copy to .env and fill in. Never commit .env.

# Local MySQL 5.7.40 (Homebrew mysql@5.7)
DATABASE_URL="mysql://root@127.0.0.1:3306/points_engine"

# development | staging | production
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000

# Set at deploy. Leave empty locally — /api/meta returns JSON null.
APP_VERSION=
GIT_TAG=
GIT_SHA=
DEPLOYED_AT=

# First superadmin (seeded only when admins table is empty). Unset password after first deploy.
SUPERADMIN_EMAIL=superadmin@points.local
SUPERADMIN_PASSWORD=superadmin123

# Session cookie signing key (32+ random bytes, hex or any long string)
SESSION_SECRET=replace-with-a-long-random-string

# AWS S3 program settings. Localhost must use the local/ key — never production/ or staging/.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SETTINGS_S3_KEY=local/program-settings.json
# Optional MinIO: AWS_S3_ENDPOINT=http://127.0.0.1:9000

# Optional demo member (Elena Cruz) + sample ledger. Production must be false.
SEED_DEMO_DATA=true
