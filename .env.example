# Copy to .env and fill in. Never commit .env.

# Local MySQL 5.7.40 (Homebrew mysql@5.7)
DATABASE_URL="mysql://root@127.0.0.1:3306/points_engine"

# development | staging | production
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000

# Set at deploy. Leave empty locally — /api/meta returns JSON null.
APP_VERSION=
GIT_TAG=
GIT_SHA=
DEPLOYED_AT=

# First superadmin (seeded only when admins table is empty). Unset password after first deploy.
SUPERADMIN_EMAIL=superadmin@points.local
SUPERADMIN_PASSWORD=superadmin123

# Session cookie signing key (32+ random bytes, hex or any long string)
SESSION_SECRET=replace-with-a-long-random-string

# Program settings JSON for this instance. Defaults:
#   development → .data/local/program-settings.json
#   staging     → .data/staging/program-settings.json
#   production  → .data/production/program-settings.json
# Override only if both Cloudera Applications share a project and you need a custom path.
# SETTINGS_FILE=.data/local/program-settings.json

# Cancel-earn / cancel-redeem feature flags (per instance). Unset = enabled.
# Local / production: true. Staging: false.
ENABLE_CANCEL_EARN=true
ENABLE_CANCEL_REDEEM=true

# Optional demo member (Elena Cruz) + sample ledger. Production must be false.
SEED_DEMO_DATA=true

# Staging Control API (local loopback service on 127.0.0.1:3100). Not used by Next.js.
# Copy deploy/mac-cloudflare/staging-control.env.example → staging-control.env (gitignored).
# STAGING_CONTROL_TOKEN=replace-with-openssl-rand-hex-32

# Cloudera start script only:
# PRISMA_DB_PUSH=true    # first boot of an empty database
# NEXT_REBUILD=true      # force next build even if .next exists
# NODE_VERSION=20.18.3
