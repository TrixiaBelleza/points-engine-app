generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  superadmin
  admin
}

enum AdminStatus {
  active
  inactive
}

enum MemberStatus {
  active
  inactive
}

enum ExpirationInterval {
  six_months @map("6_months")
  one_year   @map("1_year")
}

enum LedgerType {
  EARN
  REDEEM
  EXPIRE
  CANCEL
  CANCEL_REDEEM
}

model Admin {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         AdminRole
  status       AdminStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  activities    Activity[]
  ledgerEntries LedgerEntry[]

  @@map("admins")
}

model Member {
  id             Int          @id @default(autoincrement())
  name           String
  contactNumber  String       @unique @map("contact_number")
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  activities    Activity[]
  pointLots     PointLot[]
  ledgerEntries LedgerEntry[]

  @@map("members")
}

model ActivityType {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  activities Activity[]

  @@map("activity_types")
}

model Activity {
  id               Int      @id @default(autoincrement())
  memberId         Int      @map("member_id")
  activityTypeId   Int      @map("activity_type_id")
  points           Int
  occurredAt       DateTime @map("occurred_at")
  note             String?
  createdByAdminId Int      @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  member         Member       @relation(fields: [memberId], references: [id])
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id])
  createdByAdmin Admin        @relation(fields: [createdByAdminId], references: [id])
  pointLot       PointLot?
  ledgerEntries  LedgerEntry[]

  @@index([memberId, occurredAt])
  @@map("activities")
}

model PointLot {
  id                  Int                 @id @default(autoincrement())
  memberId            Int                 @map("member_id")
  activityId          Int                 @unique @map("activity_id")
  originalAmount      Int                 @map("original_amount")
  remainingAmount     Int                 @map("remaining_amount")
  cancelledAmount     Int                 @default(0) @map("cancelled_amount")
  restoredAmount      Int                 @default(0) @map("restored_amount")
  earnedAt            DateTime            @map("earned_at")
  expiresAt           DateTime            @map("expires_at")
  expirationInterval  ExpirationInterval  @map("expiration_interval")
  createdAt           DateTime            @default(now()) @map("created_at")

  member        Member           @relation(fields: [memberId], references: [id])
  activity      Activity         @relation(fields: [activityId], references: [id])
  consumptions  LotConsumption[]

  @@index([memberId, expiresAt])
  @@index([expiresAt, remainingAmount])
  @@map("point_lots")
}

model LedgerEntry {
  id               Int        @id @default(autoincrement())
  memberId         Int        @map("member_id")
  type             LedgerType
  amount           Int
  occurredAt       DateTime   @map("occurred_at")
  activityId       Int?       @map("activity_id")
  sourceLedgerId   Int?       @map("source_ledger_id")
  note             String?
  createdByAdminId Int?       @map("created_by_admin_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  member         Member           @relation(fields: [memberId], references: [id])
  activity       Activity?        @relation(fields: [activityId], references: [id])
  createdByAdmin Admin?           @relation(fields: [createdByAdminId], references: [id])
  consumptions   LotConsumption[]

  @@index([memberId, occurredAt])
  @@index([memberId, type])
  @@index([sourceLedgerId])
  @@map("ledger_entries")
}

model LotConsumption {
  id            Int @id @default(autoincrement())
  lotId         Int @map("lot_id")
  ledgerEntryId Int @map("ledger_entry_id")
  amount        Int

  lot         PointLot    @relation(fields: [lotId], references: [id])
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id])

  @@index([lotId])
  @@index([ledgerEntryId])
  @@map("lot_consumptions")
}
